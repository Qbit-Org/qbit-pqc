# Build output and local scratch (also git-ignored).
lib/
coverage/
.context/
node_modules/

# Byte-exact paths, never reformatted: vendor/ must stay blob-equal to
# upstream (pnpm check:vendor), fixtures/ are hashed byte-for-byte
# (fixtures/*.sha256), wasm/SHA256SUMS pins pqc.mjs and pqc.wasm (pnpm
# check:wasm), and native/ is the C shim and glue source of that pinned build
# (pnpm check:wasm:repro).
vendor/
fixtures/
wasm/
native/

# Declarations copied from qbit-js, kept as qbit-js formats them so they can
# be compared line for line with the commit they name.
test/types/qbit-js/

# Prose and workflows keep their hand-written wrapping, and pnpm writes
# pnpm-lock.yaml and package.json itself.
*.md
*.yml
*.yaml
pnpm-lock.yaml
package.json
